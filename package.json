{
  "name": "obsidian-notable",
  "version": "0.3.0",
  "description": "Brings typed notes, handwriting, journal dates, and tags from Notable and Bopa into your vault.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "test": "node --test --experimental-strip-types tests/*.test.ts"
  },
  "keywords": [
    "obsidian",
    "handwriting",
    "couchdb",
    "notable"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.24.0",
    "obsidian": "^1.7.2",
    "typescript": "^5.7.2"
  }
}
